# ---------------------------------------------------------------------------
# Private, confidential, or third-party reference material
# ---------------------------------------------------------------------------

# Personal consulting agreements and external PDFs outside Docs/
*.pdf
!Docs/**/*.pdf

# Third-party books, papers, formula collections, and official platform captures
# (Keep the Books/ directory structure, README catalogs, and bibliographies tracked)
Books/books/*
!Books/books/README.md
Books/research-papers/*
!Books/research-papers/README.md
Books/technical-guides/*
!Books/technical-guides/README.md
Books/official-documentation/*
!Books/official-documentation/README.md

# Platform automation library and notebooks (local credential-handling flow)
Tools/api-and-automation/ace-api/

# ---------------------------------------------------------------------------
# Machine-specific, build output, and virtual environments
# ---------------------------------------------------------------------------
.remember/
.freebuff/
.venv/
.venv-docs/
.venv-docs*/
venv/
__pycache__/

# Built documentation site (regenerate with: .venv-docs/bin/mkdocs build --strict)
site/
*.pyc
*.pyo
.cache/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
*.log
*.pid
*.swp
*~

# Local audit / scratch files
_private_review/
_scratch/
*.local.md
